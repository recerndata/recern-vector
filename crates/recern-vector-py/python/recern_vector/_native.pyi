import sys
from collections.abc import Iterable, Sequence
from os import PathLike
from pathlib import Path
from typing import Any, Literal, Self

if sys.version_info >= (3, 12):
    from collections.abc import Buffer
else:
    from typing_extensions import Buffer

Vector = Sequence[float] | Buffer
Metadata = Any

FORMAT_VERSION: int

class RecernVectorError(Exception): ...
class CorruptDatabaseError(RecernVectorError): ...

class Hit:
    @property
    def id(self) -> str: ...
    @property
    def distance(self) -> float: ...
    @property
    def metadata(self) -> Metadata | None: ...

class Record:
    @property
    def id(self) -> str: ...
    @property
    def vector(self) -> list[float]: ...
    @property
    def metadata(self) -> Metadata | None: ...

class SearchReport:
    @property
    def hits(self) -> list[Hit]: ...
    @property
    def strategy(self) -> Literal["hnsw", "exact", "filtered_exact"]: ...
    @property
    def ef(self) -> int | None: ...
    @property
    def visited(self) -> int: ...
    @property
    def distance_computations(self) -> int: ...
    @property
    def filter_selectivity(self) -> float | None: ...
    @property
    def elapsed_ms(self) -> float: ...

class RecallPoint:
    @property
    def ef(self) -> int: ...
    @property
    def recall(self) -> float: ...
    @property
    def p50_ms(self) -> float: ...
    @property
    def p95_ms(self) -> float: ...

class RecallReport:
    @property
    def k(self) -> int: ...
    @property
    def sample(self) -> int: ...
    @property
    def exact_p50_ms(self) -> float: ...
    @property
    def points(self) -> list[RecallPoint]: ...

class Database:
    """A database file. Changes stay in memory until `save()` or a clean `with` exit."""

    def __init__(self, path: str | PathLike[str]) -> None:
        """Opens an existing database file."""
    @staticmethod
    def create(path: str | PathLike[str]) -> Database: ...
    @staticmethod
    def open_or_create(path: str | PathLike[str]) -> Database: ...
    @staticmethod
    def open_read_only(path: str | PathLike[str]) -> Database: ...
    @property
    def read_only(self) -> bool: ...
    @property
    def identity(self) -> str: ...
    @property
    def checkpoint_policy(self) -> dict[str, int | None]: ...
    def set_checkpoint_policy(self, *, max_wal_bytes: int | None = None, max_commits: int | None = None) -> None:
        """Omitted thresholds are disabled; an empty call selects manual checkpoints."""
    def persistence_stats(self) -> dict[str, int | str | None]: ...
    def checkpoint(self) -> None: ...
    def upgrade_storage(self) -> Path | None: ...
    @property
    def format_version(self) -> int: ...
    @property
    def path(self) -> Path: ...
    def create_collection(
        self,
        name: str,
        dim: int,
        metric: Literal["cosine", "l2", "dot"] = "cosine",
        m: int = 16,
        ef_construction: int = 200,
        ef_search: int = 64,
        *, quantization: Literal["f32", "int8"] = "f32",
    ) -> Collection: ...
    def collection(self, name: str) -> Collection: ...
    def drop_collection(self, name: str) -> None: ...
    def collection_names(self) -> list[str]: ...
    def save(self) -> None: ...
    def __getitem__(self, name: str) -> Collection: ...
    def __contains__(self, name: str) -> bool: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> bool: ...

class Collection:
    @property
    def name(self) -> str: ...
    @property
    def dim(self) -> int: ...
    @property
    def metric(self) -> Literal["cosine", "l2", "dot"]: ...
    @property
    def quantization(self) -> Literal["f32", "int8"]: ...
    def upsert(self, id: str, vector: Vector, metadata: Metadata | None = None) -> None: ...
    def upsert_many(
        self,
        ids: Sequence[str],
        vectors: Buffer | Iterable[Vector],
        metadatas: Iterable[Metadata | None] | None = None,
        *,
        threads: int | None = None,
    ) -> int: ...
    def delete(self, id: str) -> bool: ...
    def get(self, id: str) -> Record | None: ...
    def records_page(self, offset: int = 0, limit: int = 100) -> tuple[list[Record], int | None]: ...
    def search(
        self,
        query: Vector,
        k: int = 10,
        *,
        ef: int | None = None,
        exact: bool = False,
        filter: Metadata | None = None,
    ) -> list[Hit]: ...
    def explain(
        self,
        query: Vector,
        k: int = 10,
        *,
        ef: int | None = None,
        exact: bool = False,
        filter: Metadata | None = None,
    ) -> SearchReport: ...
    def stats(self) -> dict[str, Any]: ...
    def estimate_recall(
        self,
        sample: int = 100,
        k: int = 10,
        ef_values: Sequence[int] = (16, 32, 64, 128, 256),
        seed: int = 42,
    ) -> RecallReport: ...
    def compact(self) -> int: ...
    def __len__(self) -> int: ...
    def __contains__(self, id: str) -> bool: ...
