{
  "name": "@recern/vector",
  "version": "0.3.0",
  "description": "Embedded Recern Vector database, native Node-API bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "portable",
    "*.node",
    "README.md",
    "LICENSE-*"
  ],
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./portable": {
      "types": "./portable/index.d.ts",
      "default": "./portable/index.js"
    }
  }
}
