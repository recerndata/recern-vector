{
  "name": "@recern/vector",
  "version": "0.5.0",
  "description": "Recern Vector database: native and portable embedded, HTTP and Qdrant APIs",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "portable",
    "*.node",
    "README.md",
    "LICENSE-*"
  ],
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./portable": {
      "types": "./portable/index.d.ts",
      "default": "./portable/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recerndata/recern-vector.git",
    "directory": "crates/recern-vector-node"
  },
  "optionalDependencies": {
    "@recern/vector-darwin-arm64": "0.5.0",
    "@recern/vector-darwin-x64": "0.5.0",
    "@recern/vector-linux-arm64-gnu": "0.5.0",
    "@recern/vector-linux-x64-gnu": "0.5.0",
    "@recern/vector-win32-x64-msvc": "0.5.0"
  }
}
